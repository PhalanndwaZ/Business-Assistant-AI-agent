{
  "customer_followup": {
    "allowed_roles": ["sales", "manager"],
    "allowed_result_types": ["customer_segments", "top_customers"],
    "required_fields": ["customer_id"],
    "max_words": 150,
    "allowed_tones": ["formal", "friendly", "brief"],
    "has_subject": true,
    "template": "Hello {{customer_name}}, it has been {{days_since_last_order}} days since your last order. I wanted to check in and see how things are going. [Your name]"
  },
  "product_update": {
    "allowed_roles": ["sales", "manager"],
    "allowed_result_types": ["product_portfolio"],
    "required_fields": ["product_id"],
    "max_words": 150,
    "allowed_tones": ["formal", "friendly", "brief"],
    "has_subject": true,
    "template": "Product update: {{product_name}} recorded revenue of {{revenue_cents}} in the selected period. [Your name]"
  },
  "supplier_inquiry": {
    "allowed_roles": ["sales", "manager"],
    "allowed_result_types": ["product_portfolio"],
    "required_fields": ["product_id"],
    "max_words": 150,
    "allowed_tones": ["formal", "friendly", "brief"],
    "has_subject": true,
    "template": "Hello, I would like to discuss {{product_name}}, which recorded revenue of {{revenue_cents}} in the selected period. [Your name]"
  },
  "management_summary": {
    "allowed_roles": ["sales", "hr", "manager"],
    "allowed_result_types": ["customer_segments", "product_portfolio", "decline_risk", "period_change", "revenue_by_product", "revenue_by_category", "revenue_by_period", "top_customers", "trend", "outliers", "headcount"],
    "required_fields": [],
    "max_words": 150,
    "allowed_tones": ["formal", "friendly", "brief"],
    "has_subject": true,
    "template": "Management summary: {{summary}} [Your name]"
  }
}
